{
  "schema_version": 1,
  "kind": "se3_goal_experiment",
  "synthetic_dimensions_only": true,
  "human_context": "cross_video",
  "domain_schedule": ["robot"],
  "lambda_human": 1.0,
  "lora": {"rank": 8, "alpha": 8},
  "training": {"max_steps": 1000, "learning_rate": 0.0001, "gradient_clip": 1.0},
  "chunk_size": 2,
  "max_frame_chunk_size": 4,
  "window_size": 32,
  "icl_rope_h": 24,
  "video_snr_shift": 5.0,
  "mcp_snr_shift": 10.0,
  "ifp": {"enabled": true, "loss_weights": [0.5, 0.25, 0.15, 0.1], "future_chunk_stride": 2},
  "goal_interface": {
    "state_dim": 4,
    "dim": 768,
    "num_tokens": 64,
    "num_heads": 8,
    "translation_scale": 1.0
  },
  "sampling_steps": 4,
  "action_sampling_steps": 4,
  "pose_weight": 1.0,
  "video_weight": 1.0
}
