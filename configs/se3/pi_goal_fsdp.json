{
  "schema_version": 3,
  "kind": "se3_goal_experiment",
  "synthetic_dimensions_only": true,
  "interface_type": "pi_goal",
  "human_context": "cross_video",
  "domain_schedule": [
    "robot"
  ],
  "lambda_human": 1.0,
  "training": {
    "max_steps": 1000,
    "learning_rate": 0.0001,
    "gradient_clip": 1.0
  },
  "chunk_size": 2,
  "max_frame_chunk_size": 4,
  "window_size": 32,
  "icl_rope_h": 24,
  "video_snr_shift": 5.0,
  "mcp_snr_shift": 10.0,
  "ifp": {
    "enabled": false,
    "loss_weights": [
      0.0,
      0.0,
      0.0,
      0.0
    ],
    "future_chunk_stride": 2
  },
  "goal_interface": {
    "state_dim": 4,
    "dim": 768,
    "num_heads": 8,
    "num_tokens": 100,
    "num_layer_groups": 1,
    "num_pose_tokens": 8,
    "translation_scale": 1.0
  },
  "action_sampling_steps": 4,
  "pose_weight": 1.0,
  "video_weight": 0.0,
  "goal_encoder": {
    "layer": 1,
    "grid_size": [
      4,
      4
    ],
    "camera_layout": [
      {
        "name": "front",
        "token_width": 1
      },
      {
        "name": "wrist",
        "token_width": 1
      }
    ]
  },
  "event_rules": {
    "signal_source": "measured",
    "close_threshold": 0.25,
    "open_threshold": 0.75,
    "debounce_steps": 2
  },
  "goal_noise": {
    "z_std": 0.0,
    "translation_std": 0.0,
    "rotation_std": 0.0,
    "gripper_std": 0.0
  },
  "conditioning_mode": "language_state_goal",
  "p_drop": 0.0,
  "distributed": {
    "enabled": true,
    "activation_checkpointing": true
  }
}
